# Local development defaults - safe to publish, never use them in production.
# Usage: cp .env.example .env && docker compose up

DB_USERNAME=myuser
DB_PASSWORD=secret

# Base64-encoded HMAC key (at least 32 bytes). FOR LOCAL USE ONLY - generate your own
# for any shared deployment, e.g. with: openssl rand -base64 48
JWT_SECRET=jQMbohRoZc+3d2YeTMwwNzQtOA2lIrkkPbZF6oiKTgdA4cVlzv8U/4sI4ObiLcmh

# Token lifetime in milliseconds (optional, defaults to 1 hour)
JWT_EXPIRATION=3600000

# "demo" seeds a demo account (demo@assistant.dev / demo1234) with sample data.
# Leave empty to start with an empty database.
SPRING_PROFILES_ACTIVE=demo
