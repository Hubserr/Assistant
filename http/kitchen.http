########## Missing ingredients to shopping list ##########

### Add missing ingredients of Nalesniki to shopping list
POST {{host}}/api/v1/kitchen/recipes/{{recipeNalesnikiId}}/missing-to-shopping-list
Authorization: Bearer {{tokenA}}

> {%
    const byName = n => response.body.find(i => i.productName === n);
    client.test("Returns 200", () => client.assert(response.status === 200));
    client.test("Two items on the list", () => client.assert(response.body.length === 2));
    client.test("jajka difference 1", () => client.assert(byName("jajka").amount === 1));
    client.test("maka difference 250", () => client.assert(byName("maka").amount === 250));
    client.test("mleko not added", () => client.assert(byName("mleko") === undefined));
    client.global.set("shopJajkaId", byName("jajka").id);
    client.global.set("shopMakaId", byName("maka").id);
%}

### Ready recipe leaves shopping list unchanged
POST {{host}}/api/v1/kitchen/recipes/{{recipeKakaoId}}/missing-to-shopping-list
Authorization: Bearer {{tokenA}}

> {%
    client.test("Returns 200", () => client.assert(response.status === 200));
    client.test("Still two items", () => client.assert(response.body.length === 2));
%}

