########## Products created by name ##########

### Add "mleko" 1000 ML to fridge
POST {{host}}/api/v1/kitchen/fridge
Authorization: Bearer {{tokenA}}
Content-Type: application/json

{ "productName": "mleko", "unit": "ML", "amount": 1000 }

> {%
    client.test("Fridge item mleko created", () => client.assert(response.status === 201));
    client.test("Amount 1000", () => client.assert(response.body.amount === 1000));
    client.global.set("fridgeMlekoId", response.body.id);
    client.global.set("mlekoProductId", response.body.productId);
%}

### Add "Mleko" 500 without unit
POST {{host}}/api/v1/kitchen/fridge
Authorization: Bearer {{tokenA}}
Content-Type: application/json

{ "productName": "Mleko", "amount": 500 }

> {%
    client.test("Existing product matched case-insensitively", () => client.assert(response.body.productId === client.global.get("mlekoProductId")));
    client.test("Same fridge item reused", () => client.assert(response.body.id === client.global.get("fridgeMlekoId")));
    client.test("Amounts summed to 1500", () => client.assert(response.body.amount === 1500));
    client.test("Unit inherited from product", () => client.assert(response.body.unit === "ML"));
%}

### Fridge has a single mleko item
GET {{host}}/api/v1/kitchen/fridge
Authorization: Bearer {{tokenA}}

> {%
    const items = response.body.filter(i => i.productName.toLowerCase() === "mleko");
    client.test("Exactly one mleko item", () => client.assert(items.length === 1));
    client.test("Mleko amount 1500", () => client.assert(items[0].amount === 1500));
%}

### No duplicate mleko product
GET {{host}}/api/v1/kitchen/products
Authorization: Bearer {{tokenA}}

> {%
    const products = response.body.filter(p => p.productName.toLowerCase() === "mleko");
    client.test("Exactly one mleko product", () => client.assert(products.length === 1));
%}

