@host = http://localhost:8080

### Register user A
POST {{host}}/api/v1/auth/register
Content-Type: application/json

{ "email": "anna@test.com", "password": "password123", "confirmPassword": "password123" }

### Login user A
POST {{host}}/api/v1/auth/login
Content-Type: application/json

{ "email": "anna@test.com", "password": "password123" }

> {% client.global.set("tokenA", response.body.token); %}

### Register user B
POST {{host}}/api/v1/auth/register
Content-Type: application/json

{ "email": "bob@test.com", "password": "password123", "confirmPassword": "password123" }

### Login user B
POST {{host}}/api/v1/auth/login
Content-Type: application/json

{ "email": "bob@test.com", "password": "password123" }

> {% client.global.set("tokenB", response.body.token); %}

### Get products without token
GET {{host}}/api/v1/kitchen/products

> {% client.test("Missing token rejected", () => client.assert(response.status === 401)); %}

### Create product Milk
POST {{host}}/api/v1/kitchen/products
Authorization: Bearer {{tokenA}}
Content-Type: application/json

{ "productName": "Milk", "unit": "ML" }

> {%
    client.test("Product Milk created", () => client.assert(response.status === 201));
    client.global.set("milkId", response.body.id);
%}

