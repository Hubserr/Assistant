########## Cook ##########

### Cook Nalesniki (maka insufficient)
POST {{host}}/api/v1/kitchen/recipes/{{recipeNalesnikiId}}/cook
Authorization: Bearer {{tokenA}}

> {%
    const byName = n => response.body.fridge.find(i => i.productName === n);
    client.test("Cook succeeds", () => client.assert(response.status === 200));
    client.test("mleko reduced to 1000", () => client.assert(byName("mleko").amount === 1000));
    client.test("jajka used up and removed", () => client.assert(byName("jajka") === undefined));
    client.test("maka used up and removed", () => client.assert(byName("maka") === undefined));
    client.test("One shortage", () => client.assert(response.body.shortages.length === 1));
    client.test("maka short by 50 G", () => {
        const s = response.body.shortages[0];
        client.assert(s.productName === "maka" && s.unit === "G" && s.missingAmount === 50);
    });
%}

### Cook Nalesniki again (jajka and maka missing)
POST {{host}}/api/v1/kitchen/recipes/{{recipeNalesnikiId}}/cook
Authorization: Bearer {{tokenA}}

> {%
    const byName = n => response.body.shortages.find(s => s.productName === n);
    client.test("Cook is never blocked", () => client.assert(response.status === 200));
    client.test("Only mleko 500 left", () => client.assert(response.body.fridge.length === 1 && response.body.fridge[0].amount === 500));
    client.test("Two shortages", () => client.assert(response.body.shortages.length === 2));
    client.test("jajka short by 3", () => client.assert(byName("jajka").missingAmount === 3));
    client.test("maka short by 250", () => client.assert(byName("maka").missingAmount === 250));
%}

### Cook Kakao (everything available)
POST {{host}}/api/v1/kitchen/recipes/{{recipeKakaoId}}/cook
Authorization: Bearer {{tokenA}}

> {%
    client.test("Cook succeeds", () => client.assert(response.status === 200));
    client.test("No shortages", () => client.assert(response.body.shortages.length === 0));
    client.test("mleko reduced to 250", () => client.assert(response.body.fridge[0].amount === 250));
%}

