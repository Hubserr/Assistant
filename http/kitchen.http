Authorization: Bearer {{tokenA}}

> {% client.test("Still three items", () => client.assert(response.body.length === 3)); %}

### Checkout jajka (list amount) and maka (bought less), skip cukier
POST {{host}}/api/v1/kitchen/shopping-list/checkout
Authorization: Bearer {{tokenA}}
Content-Type: application/json

{ "items": [ { "id": {{shopJajkaId}} }, { "id": {{shopMakaId}}, "amount": 200 } ] }

> {%
    const byName = n => response.body.find(i => i.productName === n);
    client.test("Checkout returns 200", () => client.assert(response.status === 200));
    client.test("jajka summed 2 + 1 = 3", () => client.assert(byName("jajka").amount === 3));
    client.test("maka uses bought amount 200", () => client.assert(byName("maka").amount === 200));
    client.test("mleko untouched", () => client.assert(byName("mleko").amount === 1500));
    client.test("cukier not in fridge", () => client.assert(byName("cukier") === undefined));
%}

