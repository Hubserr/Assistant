### Create recipe Nalesniki (mleko available, jajka insufficient, maka missing)
POST {{host}}/api/v1/kitchen/recipes
Authorization: Bearer {{tokenA}}
Content-Type: application/json

{
  "name": "Nalesniki",
  "servings": 2,
  "prepTimeMinutes": 30,
  "steps": ["Wymieszaj", "Usmaz"],
  "ingredients": [
    { "productName": "mleko", "amount": 500 },
    { "productName": "Jajka", "amount": 3 },
    { "productName": "maka", "unit": "G", "amount": 250 }
  ]
}

> {%
    client.test("Recipe Nalesniki created", () => client.assert(response.status === 201));
    const maka = response.body.ingredients.find(i => i.productName === "maka");
    client.test("Statuses returned on create", () => client.assert(maka.availability === "MISSING"));
    client.global.set("recipeNalesnikiId", response.body.id);
    client.global.set("makaProductId", maka.productId);
%}

### Create recipe Kakao (everything available)
POST {{host}}/api/v1/kitchen/recipes
Authorization: Bearer {{tokenA}}
Content-Type: application/json

{
  "name": "Kakao",
  "servings": 1,
  "steps": ["Podgrzej mleko"],
  "ingredients": [
    { "productName": "mleko", "amount": 250 }
  ]
}

> {%
    client.test("Recipe Kakao created", () => client.assert(response.status === 201));
    client.global.set("recipeKakaoId", response.body.id);
%}

### Get Nalesniki with ingredient statuses
GET {{host}}/api/v1/kitchen/recipes/{{recipeNalesnikiId}}
Authorization: Bearer {{tokenA}}

> {%
    const byName = n => response.body.ingredients.find(i => i.productName === n);
    client.test("mleko AVAILABLE", () => client.assert(byName("mleko").availability === "AVAILABLE"));
    client.test("mleko availableAmount 1500", () => client.assert(byName("mleko").availableAmount === 1500));
    client.test("jajka INSUFFICIENT", () => client.assert(byName("jajka").availability === "INSUFFICIENT"));
    client.test("jajka availableAmount 2", () => client.assert(byName("jajka").availableAmount === 2));
    client.test("maka MISSING", () => client.assert(byName("maka").availability === "MISSING"));
    client.test("maka availableAmount 0", () => client.assert(byName("maka").availableAmount === 0));
%}

### Recipe list shows missing ingredients
GET {{host}}/api/v1/kitchen/recipes?name=Nalesniki
Authorization: Bearer {{tokenA}}

> {%
    const r = response.body.content[0];
    client.test("Availability MISSING_INGREDIENTS", () => client.assert(r.availability === "MISSING_INGREDIENTS"));
    client.test("Two ingredients missing", () => client.assert(r.missingIngredientsCount === 2));
%}

