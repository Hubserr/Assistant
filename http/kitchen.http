    client.test("Recipe has 3 steps in order", () => client.assert(response.body.steps[0] === "Mix flour with eggs"));
    client.test("Nutrition returned", () => client.assert(response.body.nutrition.calories === 450));
    client.test("Creation date returned", () => client.assert(response.body.createdAt != null));
%}

### Update recipe
PUT {{host}}/api/v1/kitchen/recipes/{{recipeId}}
Authorization: Bearer {{tokenA}}
Content-Type: application/json

